APP_NAME=HPTECH Platform

APP_ENV=development

DATABASE_URL=

# Obrigatório: use um segredo aleatório com pelo menos 32 caracteres.
JWT_SECRET=

JWT_ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=60

# Proteção do login: tentativas por combinação de email normalizado e IP.
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# Origens explícitas, separadas por vírgula. Em produção, use somente HTTPS.
CORS_ORIGINS=http://localhost:3000

# Email transacional (backend only). Nunca use NEXT_PUBLIC para a chave.
RESEND_API_KEY=
EMAIL_FROM=HPTECH Platform <no-reply@example.com>
FRONTEND_PUBLIC_URL=http://localhost:3000
USER_INVITATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=60
